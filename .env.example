# OpenAI-compatible AI provider. These values are server-only; never expose the key in the browser.
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_API_KEY=replace_with_your_provider_key
# Use a vision-capable model for the stage reference analyzer.
AI_PROVIDER_MODEL=gpt-4.1-mini

# Product metadata
NEXT_PUBLIC_APP_TITLE=秀谱 XiuPu
NEXT_PUBLIC_APP_DESCRIPTION=秀演创作工作台

# Optional for future persistence features; not required for the local demo.
DATABASE_URL=postgresql://postgres:password@localhost:5432/xiupu
